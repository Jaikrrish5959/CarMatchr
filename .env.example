# CarMatchr Environment Configuration
# Copy this file to .env and fill in your values

# JWT Secret — REQUIRED — generate with: openssl rand -base64 32
JWT_SECRET=

# Server port (default: 4001)
PORT=4001

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Postgres connection string
# Example: postgres://postgres:password@localhost:5432/carmatchr
DATABASE_URL=

# Set to true when using hosted Postgres that requires SSL
PGSSL=false

# SMTP email settings for login OTP delivery
# Required in production; in development the backend can fall back to an Ethereal test inbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=CarMatchr Verification
SMTP_FROM_EMAIL=

# Node environment
NODE_ENV=development
